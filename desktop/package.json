{
  "name": "reaper-companion",
  "productName": "Reaper",
  "version": "0.2.0",
  "private": true,
  "description": "The reaper from Dylan Dyal's webspace, loose on your desktop.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/oracle.mjs && node tests/minds.mjs && node tests/engine.mjs && node tests/crypt.mjs && node tests/launch.mjs",
    "pacing": "node tools/pacing.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "fetch-llama": "node tools/fetch-llama-server.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "author": "Dylan Dyal",
  "build": {
    "appId": "io.github.dylan3737.reaper",
    "productName": "Reaper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "oracle.js",
      "offline.js",
      "crypt.js",
      "screens.js",
      "preload.cjs",
      "renderer/**",
      "assets/**",
      "package.json",
      "freemind.js"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "artifactName": "Reaper-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "vendor/llama/${platform}-${arch}",
        "to": "llama"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dylan3737/y2k-site.git"
  }
}
